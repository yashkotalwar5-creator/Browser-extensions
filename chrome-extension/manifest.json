{
  "manifest_version": 3,
  "name": "YouTube Ultimate PowerPack - Phase 1",
  "version": "1.0",
  "description": "10-in-1 extension bundle mastering interface, layout, and control optimization.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
